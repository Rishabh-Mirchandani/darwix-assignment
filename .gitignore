# Secrets - NEVER commit (assignment requirement)
.env
*.key
secrets/

# Python
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# Data artifacts (regenerable; keep dirs via .gitkeep)
data/raw/*
data/interim/*
!data/**/.gitkeep
# The crawl and PDF manifests ARE committed: they are the evidence for
# the brief's "handle extraction failures and flag obvious source
# errors" requirement (5 sitemap 404s, 2 live test pages, per-URL
# status for every fetch). Without them that claim is unverifiable.
!data/interim/crawl_manifest.json
!data/interim/pdf_manifest.json

# Large binaries - audio is committed selectively.
# The Q4 demo call IS committed (612KB): it is the sample input a reviewer
# needs to reproduce the pipeline run, and it carries the pre-written
# ground-truth labels the false-positive analysis is scored against.
*.wav
*.mp3
*.webm
!data/audio/q4_demo_call/*.mp3
# Recorded human browser calls: the brief requires recorded calls and
# audio samples, and these are the only HUMAN-voice artifacts in the
# repo. Both sides of every turn, ~520KB per call.
!data/audio/call_*/*.mp3
!data/audio/call_*/*.webm
# Q3 calls rendered to audio with native fil-PH / id-ID voices. The brief
# requires two RECORDED calls per market, and these are also the
# evidence for the native-TTS requirement.
!data/audio/q1_*/*.mp3
!data/audio/q3_*/*.mp3
!q1_voice_agent/calls/**/*.mp3
!q3_localized/calls/**/*.mp3

# Vector store
chroma_db/
*.sqlite3

# Model caches
.cache/
models/

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/

# Lead database: generated by test calls. Synthetic, but it is a store of
# 'customer' records and the brief forbids committing customer information.
# Regenerated automatically on the first call.
data/leads.db
