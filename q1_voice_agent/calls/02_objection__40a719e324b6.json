  "transcript": [
    {
      "role": "agent",
      "text": "Hi, this is Meera from Niva Bupa. I'm calling about health insurance options for you \u2014 is now a good time for a quick chat?",
      "at": "2026-10-02T06:32:38.130498+00:00",
