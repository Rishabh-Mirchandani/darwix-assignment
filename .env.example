# ---------------------------------------------------------------
# Darwix AI Engineer Assessment - environment template
#
# Copy this file to .env and paste your own keys there.
# NEVER put real keys in THIS file - it is committed to git.
# .env is gitignored; .env.example is not.
# ---------------------------------------------------------------

# Groq - free tier, no credit card.
# Powers ALL LLM inference and Whisper ASR (Q1, Q3, Q4).
# Get one at: https://console.groq.com/keys
GROQ_API_KEY=

# Google AI Studio - free tier, no credit card.
# Optional: not on any critical path. Retained for offline/batch work only;
# it was dropped from the voice path after measuring 3.4-5.6s per turn.
# Get one at: https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# ---- Optional overrides (defaults and rationale in shared/config.py) ----
# GROQ_ASR_MODEL=whisper-large-v3-turbo
# GROQ_CHAT_MODEL=qwen/qwen3.8-27b
# GROQ_NUDGE_MODEL=qwen/qwen3.8-27b
# EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# RERANKER_MODEL=Xenova/ms-marco-MiniLM-L-6-v2
